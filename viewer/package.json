{
  "name": "walker-game",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:quest": "adb reverse tcp:5179 tcp:5179 && vite --host 127.0.0.1",
    "mirror:quest": "scrcpy --no-audio --no-control --max-fps 30 --video-codec=h265 --video-bit-rate 20M --crop 1600:900:70:510 --window-title \"Quest 2 (left eye)\"",
    "mirror:quest:both": "scrcpy --no-audio --no-control --max-fps 30 --video-codec=h265 --video-bit-rate 20M --max-size 1920 --window-title \"Quest 2 (both eyes)\"",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.ts",
    "e2e": "node e2e/run.ts",
    "e2e:xr": "node e2e/xr.ts",
    "e2e:frontend": "node e2e/frontend.ts",
    "e2e:frontend:xr": "node e2e/frontend-xr.ts",
    "e2e:renovations": "node e2e/renovations.ts",
    "e2e:layers": "node e2e/layers.ts",
    "quest:sweep": "node e2e/quest-sweep.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@sparkjsdev/spark": "^2.4.0",
    "qrcode": "1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "1.5.5",
    "@types/three": "^0.186.0",
    "iwer": "2.5.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
